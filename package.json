{
  "name": "ELECTRON",
  "productName": "Electron Orbital Visualizer",
  "version": "1.0.0",
  "description": "A high-performance 3D atomic electron orbital visualizer",
  "main": "./out/main/index.js",
  "author": "Deborudra De",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/debo-flow/ELECTRON.git"
  },
  "keywords": [
    "electron",
    "physics",
    "orbital",
    "threejs",
    "quantum",
    "visualization"
  ],
  "homepage": "https://github.com/debo-flow/ELECTRON#readme",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "lint": "eslint . --ext .ts,.js && prettier --check .",
    "test": "vitest run",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@types/three": "^0.165.0",
    "electron": "^45.2.3",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "three": "^0.165.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "electron-updater": "^6.1.8"
  }
}
